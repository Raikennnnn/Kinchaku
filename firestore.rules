rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Each person can reach only their own records (users/{their uid}/...), only
// in the tables the app uses, and every write has to look like a record the
// app makes: stamped with the server's time, a matching id, bounded text and
// picture sizes, and no piles of extra fields. Everything else is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{table}/{id} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function knownTable() {
        return table in ['ledgers', 'categories', 'accounts', 'transactions', 'transfers',
                         'budgets', 'recurring', 'goals', 'goalDeposits', 'settings'];
      }

      function shortText(d, field, max) {
        return !(field in d) || (d[field] is string && d[field].size() <= max);
      }

      function smallIcon(d) {
        return !('icon' in d) || d.icon is string
          || (d.icon is map && (!('dataUrl' in d.icon)
              || (d.icon.dataUrl is string && d.icon.dataUrl.size() <= 300000)));
      }

      function validRecord() {
        let d = request.resource.data;
        return d.syncedAt == request.time
          && d.updatedAt is int
          && d.keys().size() <= 20
          && id.size() <= 160
          && (table == 'settings'
              ? d.key == id
                && d.keys().hasOnly(['key', 'value', 'updatedAt', 'syncedAt'])
                && (!(d.value is string) || d.value.size() <= 40)
              : d.id == id
                && d.deleted is bool
                && d.createdAt is int
                && shortText(d, 'name', 40)
                && shortText(d, 'note', 200)
                && smallIcon(d));
      }

      allow read, delete: if isOwner() && knownTable();
      allow create, update: if isOwner() && knownTable() && validRecord();
    }
  }
}
