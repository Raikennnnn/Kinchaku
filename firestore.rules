rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Each person can read and write only their own records, in the tables the
// app uses. Nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{table}/{id} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && table in ['ledgers', 'categories', 'accounts', 'transactions', 'transfers',
                     'budgets', 'recurring', 'goals', 'goalDeposits', 'settings'];
    }
  }
}
